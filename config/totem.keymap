// TOTEM — Norwegian layout
// BASE: qwerty + homerow mods, æøå on combos
// NAV:  hold RIGHT middle thumb — numbers left, vim nav right
// SYM:  hold LEFT middle thumb — shift-numbers left, code symbols right

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define GAME  3
#define GAME2 4

&mt {
  quick-tap-ms = <100>;
  require-prior-idle-ms = <100>;
  flavor = "tap-preferred";
  tapping-term-ms = <220>;
};

/ {
    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };
        combo_ae {
            timeout-ms = <50>;
            key-positions = <6 7>;   // u + i
            bindings = <&kp SQT>;    // æ
            layers = <0>;
        };
        combo_oe {
            timeout-ms = <50>;
            key-positions = <7 8>;   // i + o
            bindings = <&kp SEMI>;   // ø
            layers = <0>;
        };
        combo_aa {
            timeout-ms = <50>;
            key-positions = <8 9>;   // o + p
            bindings = <&kp LBKT>;   // å
            layers = <0>;
        };
        combo_game {
            timeout-ms = <50>;
            key-positions = <20 31>;
            bindings = <&tog GAME>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
display-name = "BASE";
 bindings = <
                &kp Q       &kp W       &kp E       &kp R       &kp T           &kp Y       &kp U       &kp I       &kp O       &kp P
                &mt LGUI A  &mt LALT S  &mt LCTRL D &mt LSHFT F &kp G           &kp H       &mt RSHFT J &mt RCTRL K &mt RALT L  &mt RGUI LS(MINUS)
    &kp LBKT    &kp Z       &kp X       &kp C       &kp V       &kp B           &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp SQT
                                        &kp DEL   &lt SYM TAB   &kp SPACE       &kp RET   &lt NAV ESC   &kp BSPC
                        >;
        };

        nav_layer {
display-name = "NAV";
//  6 7 8 9 0        wordL  _   _  wordR  _
//  1 2 3 4 5          <    v   ^    >    _
//  _ _ _ _ _        Home PgDn PgUp End  Del
 bindings = <
                &kp N6      &kp N7      &kp N8      &kp N9      &kp N0          &kp LC(LEFT) &trans     &trans    &kp LC(RIGHT) &trans
                &kp N1      &kp N2      &kp N3      &kp N4      &kp N5          &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &trans
    &trans      &trans      &trans      &trans      &trans      &trans          &kp HOME    &kp PG_DN   &kp PG_UP   &kp END     &kp DEL     &trans
                                        &trans      &trans      &trans          &trans      &trans      &trans
                        >;
        };

        sym_layer {
display-name = "SYM";
//  & / ( ) =         `  ~  <  >  ^
//  ! " # ¤ %         {  [  ]  }  |
//  BTn BTp _ _ _     \  *  +  -  ´
 bindings = <
                &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)      &kp LS(EQUAL) &kp RA(RBKT) &kp NON_US_BSLH &kp LS(NON_US_BSLH) &kp LS(RBKT)
                &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)      &kp RA(N7)  &kp RA(N8)  &kp RA(N9)  &kp RA(N0)  &kp GRAVE
    &bt BT_CLR  &bt BT_NXT  &bt BT_PRV  &trans      &trans      &trans          &kp EQUAL    &kp LS(BSLH) &kp MINUS  &kp FSLH    &kp RA(BSLH) &trans
                                        &trans      &trans      &trans          &trans      &trans      &trans
                        >;
        };
        game_layer {
display-name = "GAME";
 bindings = <
                &kp G       &kp Q       &kp W       &kp E       &kp R           &none       &none       &none       &none       &none
                &kp C       &kp A       &kp S       &kp D       &kp F           &none       &none       &none       &none       &none
    &kp LCTRL   &kp LSHFT   &kp N1      &kp N2      &kp N3      &kp N4          &none       &none       &none       &none       &none       &none
                                        &kp LALT  &mo GAME2     &kp SPACE       &none       &none       &none
                        >;
        };

        game2_layer {
display-name = "GAME2";
 bindings = <
                &kp ESC     &none       &none       &none       &none           &none       &none       &none       &none       &none
                &none       &none       &none       &none       &none           &none       &none       &none       &none       &none
    &kp TAB     &none       &kp N5      &kp N6      &kp N7      &kp N8          &none       &none       &none       &none       &none       &none
                                        &none       &trans      &none           &none       &none       &none
                        >;
        };
    };
};
